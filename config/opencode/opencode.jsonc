{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-sonnet-4.6",
  "mcp": {
    "context7": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/oauth",
    },
  },
  "permission": {
    "bash": {
      "rm *": "ask",
      "git *": "allow",
      "git push *": "ask",
    },
  },
  "agent": {
    "plan": {
      "model": "github-copilot/gpt-5.4",
    },
    "build": {
      "model": "github-copilot/claude-sonnet-4.6",
    },
  },
  "plugin": ["opencode-skill-creator"],
}
