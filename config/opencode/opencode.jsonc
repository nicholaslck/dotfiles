{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "blender": {
      "enabled": false,
      "type": "local",
      "command": ["uvx", "blender-mcp"],
    },
    "context7": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/oauth",
    },
    "linear": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
    },
    "pencil": {
      "command": [
        "/Applications/Pencil.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
        "--app",
        "desktop",
      ],
      "enabled": false,
      "type": "local",
    },
    "chrome-devtools": {
      "command": ["bunx", "chrome-devtools-mcp"],
      "enabled": false,
      "type": "local",
    },
  },
  "permission": {
    "bash": {
      "rm *": "ask",
      "git *": "allow",
      "git push *": "ask",
    },
  },
  "agent": {
    "plan": {
      "model": "opencode/big-pickle",
    },
    "build": {
      "model": "opencode/big-pickle",
    },
  },
  "shell": "zsh",
}
