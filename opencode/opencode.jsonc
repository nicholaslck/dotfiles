{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "Blender": {
      "enabled": false,
      "type": "local",
      "command": ["uvx", "blender-mcp"],
    },
    "Context7": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
    "Linear": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
    },
  },
  "permission": {
    "bash": {
      "rm *": "ask",
      "git *": "allow",
      "git push *": "ask",
    },
  },
}
